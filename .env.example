# Kezza AI — Backend Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Gemini AI (Server-side — NEVER expose in frontend) ───────────────────────
# Get from: https://aistudio.google.com/app/apikey (free) or Google Cloud (paid/Vertex AI)
# NOTE: Free-tier (AI Studio) keys may be used for model training per Google's terms.
# For health-adjacent data in production, consider a paid Vertex AI key + Cloud DPA.
GEMINI_API_KEY=

# Gemini model used for photo/vision analysis (swap here, not in code)
# Options: gemini-2.0-flash | gemini-2.5-flash-preview-04-17 | gemini-2.5-pro-preview
GEMINI_PHOTO_MODEL=gemini-2.0-flash

# Gemini model used for text chat
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ─── Photo Analysis Controls ───────────────────────────────────────────────────
# Minimum quality/confidence score (0–100) to show a treatment recommendation.
# Below this threshold: "Doctor consultation recommended." (no specific treatment)
CONFIDENCE_THRESHOLD=60

# Max photo analyses per IP per 10-minute window (vision calls cost ~10–30× more)
RATE_LIMIT_PHOTO=5

# Append-only audit log path (one JSON line per photo analysis — no image bytes)
# Default: photo-analysis.log in the project root
PHOTO_AUDIT_LOG=

# ─── Server Config ─────────────────────────────────────────────────────────────
PORT=3001

# ─── CORS — Allowed origins (comma-separated) ─────────────────────────────────
# Production: set to your actual domain (e.g. https://kezza.co.in)
# Development: http://localhost:8080 or use Live Server
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per IP per minute for /api/chat endpoint
RATE_LIMIT_CHAT=30
# Max consultation submissions per IP per hour
RATE_LIMIT_CONSULT=10

