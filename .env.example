# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key — powers /api/chat and /api/analyze-photo.
# Without it those endpoints return status NO_GEMINI_KEY and the site
# falls back to its offline chatbot responses.
GEMINI_API_KEY=

# Shared token protecting the admin dashboard APIs. The admin page asks
# for this value once and stores it in the browser. Leave it blank and
# the admin API stays disabled (returns 503) rather than open.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Google Apps Script webhook that appends leads to the clinic spreadsheet.
# Falls back to the URL hardcoded in server.js when unset.
SHEET_WEBHOOK_URL=

# Where captured leads are stored on disk (JSON).
LEAD_STORE_PATH=./data/leads.json

# Server port. Defaults to 3001.
PORT=3001

# Set to "production" to enable 1-day caching of CSS/JS.
NODE_ENV=development
