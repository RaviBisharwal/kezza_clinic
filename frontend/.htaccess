# ─────────────────────────────────────────────────────────────────────
# Kezza Hair & Skin Clinic — Apache / LiteSpeed config (GoDaddy cPanel)
# Upload to the web root (public_html) next to index.html.
# Every block is wrapped in <IfModule> so a missing module can't 500 the site.
# ─────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# ── 1. One canonical host: https://www.kezza.co.in ───────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # kezza.co.in (http or https)  ->  https://www.kezza.co.in  (single 301 hop)
    # The optional ":port" covers servers that pass the host as "kezza.co.in:443".
    # CHECK AFTER UPLOAD: https://kezza.co.in/hair-transplant/ must jump to
    # https://www.kezza.co.in/hair-transplant/ (Semrush's hreflang error came from the
    # non-www copy of that page, which the live server was still serving on 10 Oct 2026).
    RewriteCond %{HTTP_HOST} ^kezza\.co\.in(:[0-9]+)?$ [NC]
    RewriteRule ^ https://www.kezza.co.in%{REQUEST_URI} [L,R=301]

    # http://www.kezza.co.in  ->  https://www.kezza.co.in
    # (X-Forwarded-Proto check prevents a loop if SSL is ever terminated upstream)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^www\.kezza\.co\.in(:[0-9]+)?$ [NC]
    RewriteRule ^ https://www.kezza.co.in%{REQUEST_URI} [L,R=301]

    # llms.txt spec path is lowercase; keep the old mixed-case URL working
    RewriteRule ^LLMs\.txt$ /llms.txt [L,R=301]

    # Folder URLs for sections (serve without the trailing-slash 404)
    RewriteRule ^hi/?$ /hi/hair-transplant/ [L,R=301]
    RewriteRule ^(locations|locations/(jaipur|sikar|ajmer)|blog|blog/[a-zA-Z0-9-]+|hair-transplant|hair-transplant/(beard|dhi|eyebrow|fue)|hi/hair-transplant|acne-treatment|acne-scar-treatment|pigmentation-treatment|botox|cryolipolysis|dark-circles-treatment|gfc-treatment|hifu-body-sculpting|hydra-facial|laser-hair-removal|lip-blush|medical-dermatology|microblading|permanent-eyeliner|pmu-correction|skin-consultation|stretch-marks-treatment|weight-management|cosmetic-surgery|rhinoplasty|blepharoplasty|scar-revision|q-switch-laser|laser-hair-removal/full-body|chemical-peel|medical-peel|microneedling|glutathione-treatment|lip-neutralization|doctors/[a-z-]+)$ /$1/ [L,R=301]

    # There is no doctors index page: the team is listed on the About page
    RewriteRule ^doctors/?$ /about.html#doctors [NE,L,R=301]

    # Universal directory trailing-slash enforcement
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# ── 2. Compression (text assets) ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
    AddOutputFilterByType DEFLATE application/manifest+json font/ttf font/otf
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# ── 3. Browser caching ───────────────────────────────────────────────
# HTML is always revalidated so content/SEO changes show immediately.
# CSS/JS: 1 year. Every page links them with a content hash (?v=…) that changes
# whenever the file changes (run `npm run build` after editing them).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 week"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/plain                "access plus 1 hour"
    ExpiresByType application/xml           "access plus 1 hour"
    ExpiresByType text/xml                  "access plus 1 hour"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/avif                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType video/mp4                 "access plus 6 months"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|avif|mp4|webm|svg|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    # HTTPS only (HSTS): browsers remember to use https for a year. They ignore this
    # header on plain-http answers, so it is safe to send on every response.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Block unauthorized third-party tracking chains (GoDaddy RUM eventbus 1,522ms chain)
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://connect.facebook.net https://cdnjs.cloudflare.com https://translate.google.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://connect.facebook.net https://next-api.telecrm.in https://script.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://maps.app.goo.gl https://www.google.com;"

    # Internal pages must never be indexed, whatever a crawler does with robots.txt
    <FilesMatch "^(admin\.html)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# ── 4. Keep private files off the public web ─────────────────────────
<FilesMatch "^\.|\.(env|log|bak|sql|db|md|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
